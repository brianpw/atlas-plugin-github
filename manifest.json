{
  "plugin": "issues",
  "named": "GitHub issues",
  "runs": "issues.mjs",
  "host": "github",
  "calls": [
    {
      "call": "readIssues",
      "method": "GET",
      "path": "/repos/{owner}/{repository}/issues",
      "fills": ["state", "labels", "per_page"],
      "label": "Read a repository's issues"
    }
  ],
  "contributes": {
    "screens": [
      {
        "screen": "issues",
        "named": "Issues",
        "under": "repository",
        "rows": "listIssues",
        "holds": [
          {
            "component": "filterBar",
            "filters": [
              {
                "filter": "state",
                "named": "State",
                "kind": "choice",
                "values": [
                  { "value": "open", "named": "Open" },
                  { "value": "closed", "named": "Closed" },
                  { "value": "all", "named": "All" }
                ],
                "byDefault": "open"
              },
              { "filter": "labels", "named": "Labels", "kind": "text" }
            ]
          },
          {
            "component": "rowList",
            "columns": [
              {
                "column": "number",
                "named": "Issue",
                "kind": "number",
                "opensAt": "https://github.com/{owner}/{repository}/issues/{value}"
              },
              { "column": "title", "named": "Title", "kind": "text" },
              { "column": "labels", "named": "Labels", "kind": "texts" },
              {
                "column": "state",
                "named": "State",
                "kind": "choice",
                "values": [
                  { "value": "open", "named": "Open" },
                  { "value": "closed", "named": "Closed" }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
